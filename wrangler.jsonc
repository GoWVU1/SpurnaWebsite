{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spurna-national-viewer",
  "main": "src/index.js",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"]
  }
}
